<h1>Welcome to the Permission update</h1>

<div class="update_container" id="permission_update_container">
    <h1>Update Permission</h1>
    <form action="/permission/update/" method="POST" class="update_form" id="permission_update_form">
        <select id="role_id" name="role_id"></select>
        <select id="operation_id" name="operation_id"></select>
        <label for="is_active">Record is active</label>
        <input type="checkbox" id="is_active" name="is_active">
        <button type="submit" id="permission_update_btn">Update</button>
    </form>
</div>