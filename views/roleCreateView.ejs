<h1>Welcome to the Role creation</h1>

<div class="create_container" id="role_create_container">
    <h1>Create Role</h1>
    <form action="/role/create" method="POST" class="create_form" id="role_create_form">
        <input type="text" id="name" name="name" placeholder="Enter role name" required>
        <textarea id="description" name="description" placeholder="Describe role" required></textarea>
        <button type="submit" id="role_create_btn">Create</button>
    </form>
</div>