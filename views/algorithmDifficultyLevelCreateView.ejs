<h1>Welcome to the Algorithm difficulty level create</h1>

<div class="create_container" id="algorithhm_difficulty_level_create_container">
    <h1>Create Algorithm difficulty level</h1>
    <form action="/algorithm-difficulty-level/create/" method="POST" class="create_form" id="algorithm_diffiulty_level_create_form">
        <input type="text" id="name" name="name" placeholder="Algorithm difficulty level name" required>
        <textarea id="description" name="description" placeholder="Algorithm difficulty level description" required></textarea>
        <button type="submit" id="algorithm_difficulty_level_create_btn">Create</button>
    </form>
</div>