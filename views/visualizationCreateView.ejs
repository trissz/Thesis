<h1>Welcome to the Visualization Creation</h1>

<div class="create_container" id="visualization_create_container">
    <h1>Create Visualization</h1>
    <form action="/visualization/create" method="POST" class="create_form" id="visualization_create_form">
        <input type="text" id="title" name="title" placeholder="Enter visualization title" required>
        <textarea id="description" name="description" placeholder="Describe visualization" required></textarea>

        <label for="script_file">Upload Visualization Script File (.js) (optional):</label>
        <input type="file" id="script_file" name="script_file" accept=".js">

        <div class="editor" id="editor"></div>
        <textarea class="editor_content" id="script_code" name="script_code"></textarea>

        <button type="submit" id="visualization_create_btn">Create</button>
    </form>
</div>