<h1>Welcome to the Module creation</h1>

<div class="create_container" id="module_create_container">
    <h1>Create Module</h1>
    <form action="/module/create" method="POST" class="create_form" id="module_create_form">
        <input type="text" id="title" name="title" placeholder="Enter module title" required>
        <textarea id="description" name="description" placeholder="Describe module" required></textarea>
        <button type="submit" id="module_create_btn">Create</button>
    </form>
</div>