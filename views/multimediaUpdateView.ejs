<h1>Welcome to the Multimedia update</h1>

<div class="update_container" id="multimedia_update_container">
    <h1>Update Multimedia</h1>
    <form action="/multimedia/update/" method="POST" class="update_form" id="multimedia_update_form">
        <label for="category_id">Select multimedia category</label>
        <select id="category_id" name="category_id" required></select>
        <label for="file">Choose a file:</label>
        <input type="file" id="file" name="file" required>
        <label for="is_active">Record is active</label>
        <input type="checkbox" id="is_active" name="is_active">
        <button type="submit" id="multimedia_update_btn">Update</button>
    </form>
</div>