<h1>Welcome to the Achievement category update</h1>

<div class="update_container" id="achievement_category_update_container">
    <h1>Update Achievement category</h1>
    <form action="/achievement-category/update/" method="POST" class="update_form" id="achievement_category_update_form">
        <input type="text" id="name" name="name" placeholder="Achievement category name" required>
        <label for="is_active">Record is active</label>
        <input type="checkbox" id="is_active" name="is_active">
        <button type="submit" id="achievement_category_update_btn">Update</button>
    </form>
</div>