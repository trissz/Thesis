<h1>Welcome to the Task difficulty level creation</h1>

<div class="create_container" id="task_difficulty_level_create_container">
    <h1>Create Task difficulty level</h1>
    <form action="/task-difficulty-level/create" method="POST" class="create_form" id="task_difficulty_level_create_form">
        <input type="text" id="name" name="name" placeholder="Enter task difficulty level name" required>
        <textarea id="description" name="description" placeholder="Describe task difficulty level" required></textarea>
        <button type="submit" id="task_difficulty_level_create_btn">Create</button>
    </form>
</div>