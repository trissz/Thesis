<h1>Create Algorithm complexity</h1>

<div class="create_container" id="algorithm_complexity_create_container">
    <h1>Create Algorithm complexity</h1>
    <form action="/algorithm-complexity/create" method="POST" class="create_form" id="algorithm_complexity_create_form">
        <label for="name">Algorithm complexity name:</label>
        <input type="text" id="name" name="name" required>
        <label for="name">Algorithm complexity notation:</label>
