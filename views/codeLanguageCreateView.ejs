<h1>Welcome to the Code language creation</h1>

<div class="create_container" id="code_language_create_container">
    <h1>Create Code language</h1>
    <form action="/code-language/create" method="POST" class="create_form" id="code_language_create_form">
        <input type="text" id="name" name="name" placeholder="Enter code language name" required>
        <input type="text" id="notation" name="notation" placeholder="Enter code language notation" required>
        <input type="text" id="key_string" name="key_string" placeholder="Enter code language key string" required>
        <textarea id="description" name="description" placeholder="Describe code language" required></textarea>
        <button type="submit" id="code_language_create_btn">Create</button>
    </form>
</div>