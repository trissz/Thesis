<h1>Welcome to the Algorithm category update</h1>

<div class="update_container" id="algorithm_category_update_container">
    <h1>Update Algorithm category</h1>
    <form action="/algorithm-category/update/" method="POST" class="update_form" id="algorithm_category_update_form">
        <input type="text" id="name" name="name" placeholder="Algorithm category name" required>
        <label for="is_active">Record is active</label>
        <input type="checkbox" id="is_active" name="is_active">
        <button type="submit" id="algorithm_category_update_btn">Update</button>
    </form>
</div>