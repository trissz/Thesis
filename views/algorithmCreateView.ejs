<h1>Welcome to the Algorithm creation</h1>

<div class="create_container" id="algorithm_create_container">
    <h1>Create Algorithm</h1>
    <form action="/algorithm/create" method="POST" class="create_form" id="algorithm_create_form">
        <select id="category_id" name="category_id"></select>
        <select id="difficulty_level_id" name="difficulty_level_id"></select>
        <input type="text" id="name" name="name" placeholder="Enter algorithm name" required>
        <button type="submit" id="algorithm_create_btn">Create</button>
    </form>
</div>