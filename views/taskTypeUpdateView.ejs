<h1>Welcome to the Task type creation</h1>

<div class="update_container" id="task_type_update_container">
    <h1>Update Task type</h1>
    <form action="/task-type/update/" method="POST" class="update_form" id="task_type_update_form">
        <input type="text" id="name" name="name" placeholder="Enter task type name" required>
        <label for="is_active">Record is active</label>
        <input type="checkbox" id="is_active" name="is_active">
        <button type="submit" id="task_type_update_btn">Update</button>
    </form>
</div>