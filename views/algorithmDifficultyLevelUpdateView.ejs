<h1>Welcome to the Algorithm difficulty level update</h1>

<div class="update_container" id="algorithm_difficulty_level_update_container">
    <h1>Update Algorithm difficulty level</h1>
    <form action="/algorithm-difficulty-level/update/" method="POST" class="update_form" id="algorithm_difficulty_level_update_form">
        <input type="text" id="name" name="name" placeholder="Algorithm difficulty level name" required>
        <textarea id="description" name="description" placeholder="Algorithm difficulty level description" required></textarea>
        <label for="is_active">Record is active</label>
        <input type="checkbox" id="is_active" name="is_active">
        <button type="submit" id="algorithm_difficulty_level_update_btn">Update</button>
    </form>
</div>