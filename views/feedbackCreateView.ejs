<h1>Welcome to the Feedback creation</h1>

<div class="create_container" id="feedback_create_container">
    <h1>Create Feedback</h1>
    <form action="/feedback/create" method="POST" class="create_form" id="feedback_create_form">
        <input type="text" id="topic" name="topic" placeholder="Enter feedback topic" required>
        <textarea id="content" name="content" placeholder="Enter feedback content" required></textarea>
        <button type="submit" id="feedback_create_btn">Create</button>
    </form>
</div>