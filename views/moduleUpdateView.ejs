<h1>Welcome to the Module update</h1>

<div class="update_container" id="module_update_container">
    <h1>Update Module</h1>
    <form action="/module/update/" method="POST" class="update_form" id="module_update_form">
        <input type="text" id="title" name="title" placeholder="Enter module title" required>
        <textarea id="description" name="description" placeholder="Describe module" required></textarea>
        <label for="is_active">Record is active</label>
        <input type="checkbox" id="is_active" name="is_active">
        <button type="submit" id="module_update_btn">Update</button>
    </form>
</div>