<h1>Welcome to the Multimedia category update</h1>

<div class="update_container" id="multimedia_category_update_container">
    <h1>Update Multimedia category</h1>
    <form action="/multimedia-category/update/" method="POST" class="update_form" id="multimedia_category_update_form">
        <label for="name">Category name:</label>
        <input type="text" id="name" name="name" required>
        <label for="is_active">Record is active</label>
        <input type="checkbox" id="is_active" name="is_active">
        <button type="submit" id="multimedia_category_update_btn">Update</button>
    </form>
</div>