<h1>Welcome to the Algorithm complexity update</h1>

<div class="update_container" id="algorithm_complexity_update_container">
    <h1>Update Algorithm complexity</h1>
    <form action="/algorith-complexity/update/" method="POST" class="update_form" id="algorithm_complexity_update_form">
        <label for="name">Algorithm complexity name:</label>
        <input type="text" id="name" name="name" required>
        <label for="notation">Algorithm complexity notation:</label>
        <input type="text" id="notation" name="notation" required>
        <label for="is_active">Record is active</label>
        <input type="checkbox" id="is_active" name="is_active">
        <button type="submit" id="algorithm_complexity_update_btn">Update</button>
    </form>
</div>