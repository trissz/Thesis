<h1>Welcome to the User update</h1>

<div class="update_container" id="user_update_container">
    <h1>Update User</h1>
    <form method="POST" action="/user/update/" class="update_form" id="user_update_form">
        <input type="text" id="name" name="name" placeholder="User name" required>
        <input type="password" id="password" name="password" placeholder="User password">
        <label for="is_active">Record is active</label>
        <input type="checkbox" id="is_active" name="is_active">
        <button type="submit" id="user_update_btn">Update</button>
    </form>
</div>